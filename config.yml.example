# Xboard Node Configuration
# Top-level settings are inherited by all instances. Instance overrides take precedence.

# ── Single node (simplest) ──
# panel:
#   url: "https://panel.example.com"
#   token: "your-api-key"
#   node_id: 1

# ── Multiple instances ──
# kernel:
#   type: "singbox"
# log:
#   level: "info"
# instances:
#   - panel:
#       url: "https://panel.example.com"
#       token: "api-key-1"
#       node_id: 1
#   - panel:
#       url: "https://panel.example.com"
#     machine:
#       machine_id: 2
#       token: "machine-token-2"
#     log:
#       level: "debug"   # override for this instance only

# ── Device (IP) limit ──
# Shared by sing-box and Xray: a user may use at most `device_limit`
# distinct source IPs (pushed per user by the panel). When the limit is
# breached, ALL of that user's connections are force-closed and every new
# connection is refused for `device_limit_cooldown` seconds.
# kernel:
#   device_limit_cooldown: 180  # 0 = default (180s), max 86400 (1 day)

# ── Local REALITY websites ──
# Maps the panel's REALITY SNI names to a camouflage website that listens on
# loopback, replacing only the handshake destination. The file is a YAML
# mapping of SNI -> loopback host:port; see README for details. The
# realityTargetsFile / REALITY_TARGETS_FILE env vars override this setting.
# kernel:
#   reality_targets_file: "/etc/xboard-node/reality-targets.yml"
